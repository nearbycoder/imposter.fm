# Required
DATABASE_URL=postgresql://postgres:password@localhost:5432/imposter_fm
BETTER_AUTH_SECRET=replace_with_a_long_random_secret

# Runtime (usually set by host platform)
PORT=3000
NODE_ENV=development

# Recommended in production
BETTER_AUTH_BASE_URL=https://imposter.fm
# Comma-separated list. Include all app/admin origins that should be trusted.
BETTER_AUTH_TRUSTED_ORIGINS=https://imposter.fm,https://www.imposter.fm

# Optional admin bootstrap script defaults
ADMIN_EMAIL=admin@imposter.fm
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# Optional client-facing site config
VITE_SITE_URL=https://imposter.fm

# Optional analytics
# Leave VITE_POSTHOG_KEY blank to disable PostHog.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Production object storage (S3-compatible)
# Use either S3_* or R2_* naming. Do not mix both.
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Some providers (including Railway bucket storage) require this:
S3_FORCE_PATH_STYLE=true

# Alternative naming (Cloudflare R2 style)
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
